soong_namespace {
}

cc_prebuilt_library_shared {
	name: "libsdm-disp-apis",
	owner: "samsung",
	// Android 12 checks that a prebuilt's DT_NEEDED entries are declared.
	// These are the blob's real dependencies, taken from check_elf_files'
	// own suggestion; libhidltransport and libhwbinder still exist in
	// LineageOS 19.1 as shims kept for legacy vendor blobs like these.
	shared_libs: [
		"libc++",
		"libcutils",
		"libhidlbase",
		"libhidltransport",
		"liblog",
		"libutils",
	],
	// vendor.display.color@1.0 is also a DT_NEEDED here, but it ships as a
	// PRODUCT_COPY_FILES blob rather than a soong module, so it cannot be named
	// in shared_libs. The remaining dependency is real, so the check is
	// disabled rather than the dependency hidden - the linker still has to find
	// vendor.display.color@1.0.so on device, where it is installed by
	// proprietary-files.txt.
	check_elf_files: false,
	strip: {
		none: true,
	},
	target: {
		android_arm: {
			srcs: ["proprietary/lib/libsdm-disp-apis.so"],
		},
		android_arm64: {
			srcs: ["proprietary/lib64/libsdm-disp-apis.so"],
		},
	},
	compile_multilib: "both",
	prefer: true,
}

